{
  "app_name": "StorageWeb",
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "threads": 8,
    "behind_proxy": true,
    "max_upload_mb": 2048
  },
  "secret_key": "",
  "data_dir": "/var/lib/storageweb",
  "session": {
    "lifetime_hours": 8,
    "cookie_secure": true
  },
  "storage": {
    "home_template": "/srv/storageweb/homes/{username}",
    "create_home": true,
    "show_hidden": false,
    "max_file_size_mb": 0,
    "shares": [
      {
        "name": "compartido",
        "label": "Compartido",
        "path": "/srv/storageweb/shared",
        "read_only": false,
        "users": [
          "*"
        ],
        "groups": []
      },
      {
        "name": "publico",
        "label": "Documentación (lectura)",
        "path": "/srv/storageweb/public",
        "read_only": true,
        "users": [
          "*"
        ],
        "groups": []
      }
    ]
  },
  "permissions": {
    "user": {
      "upload": true,
      "download": true,
      "mkdir": true,
      "rename": false,
      "delete": false
    }
  },
  "auth": {
    "local": {
      "enabled": true
    },
    "pam": {
      "enabled": false,
      "service": "login",
      "allowed_groups": [
        "storageweb-users"
      ],
      "use_system_home": false,
      "admin_groups": [
        "storageweb-admins"
      ]
    },
    "entra": {
      "enabled": false,
      "provider": "oauth2",
      "tenant_id": "00000000-0000-0000-0000-000000000000",
      "client_id": "00000000-0000-0000-0000-000000000000",
      "client_secret": "CAMBIAR",
      "redirect_uri": "https://files.midominio.com/auth/entra/callback",
      "scopes": [
        "User.Read"
      ],
      "button_label": "Iniciar sesión con Microsoft",
      "username_claim": "preferred_username",
      "strip_domain": false,
      "allowed_groups": [],
      "auto_provision": true,
      "default_role": "user",
      "role_mappings": {
        "StorageWeb.Admin": "admin"
      },
      "sync_role_on_login": true,
      "single_logout": false,
      "authorize_url": "",
      "token_url": "",
      "issuer": "",
      "logout_url": "",
      "timeout_seconds": 15
    }
  },
  "security": {
    "max_login_failures": 5,
    "lockout_minutes": 15
  }
}
