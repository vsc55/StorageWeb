{
  // Tareas de StorageWeb. Ejecuta primero "StorageWeb: crear entorno .venv".
  // Ctrl+Shift+B lanza el servidor de pruebas (tarea de build por defecto).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "StorageWeb: crear entorno .venv",
      "detail": "Crea .venv e instala el paquete en modo editable con las dependencias de desarrollo",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/python -m pip install -U pip && .venv/bin/python -m pip install -e '.[dev]'",
      "windows": {
        "command": "python -m venv .venv; if ($?) { .venv\\Scripts\\python.exe -m pip install -U pip }; if ($?) { .venv\\Scripts\\python.exe -m pip install -e '.[dev]' }",
        "options": {
          "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
        }
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "StorageWeb: servidor de pruebas (auto-reload)",
      "detail": "http://127.0.0.1:8080 con config/config.dev.json; se reinicia al cambiar .py, config o plantillas",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "storageweb", "--config", "config/config.dev.json", "serve", "--dev"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONUNBUFFERED": "1", "PYTHONDONTWRITEBYTECODE": "1" }
      },
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "storageweb",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^\\s*File \"(.+)\", line (\\d+), in (.+)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeBegin": true,
          "beginsPattern": "(Restarting with|Detected change)",
          "endsPattern": "(Running on|Debugger PIN)"
        }
      }
    },
    {
      "label": "StorageWeb: crear usuario de pruebas",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "storageweb", "--config", "config/config.dev.json", "user-add", "${input:devUser}", "--role", "${input:devRole}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "focus": true }
    },
    {
      "label": "StorageWeb: cambiar contraseña de un usuario",
      "detail": "Usuarios locales; pide la contraseña nueva en el terminal. También en Personas → Usuarios",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "storageweb", "--config", "config/config.dev.json", "user-passwd", "${input:devUser}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "focus": true }
    },
    {
      "label": "StorageWeb: empaquetar la extensión de VS Code",
      "detail": "clients/vscode/dist/storageweb-sync-<versión>.vsix y, si quieres, la instala en este VS Code",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["tools/build_vsix.py", "${input:installVsix}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "StorageWeb: tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "StorageWeb: documentación (servir)",
      "detail": "mkdocs serve en http://127.0.0.1:8000 con recarga automática (requiere pip install -e '.[docs]')",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "mkdocs", "serve"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "mkdocs",
        "pattern": { "regexp": "^(WARNING|ERROR)\\s+-\\s+(.*)$", "severity": 1, "message": 2 },
        "background": { "activeBegin": true, "beginsPattern": "Building documentation", "endsPattern": "Serving on" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "StorageWeb: regenerar referencia",
      "detail": "Regenera docs/referencia/{configuracion,cli,api}.md desde el código",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["tools/gen_docs.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "StorageWeb: actualizar traducciones",
      "detail": "Extrae los textos del código y plantillas y actualiza los catálogos .po (luego: comprobar traducciones)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["tools/i18n.py", "update"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "StorageWeb: comprobar traducciones",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["tools/i18n.py", "check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "StorageWeb: tests unitarios",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "pytest", "-q", "tests/unit"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "devUser",
      "type": "promptString",
      "description": "Nombre del usuario local de pruebas (la contraseña se pedirá en el terminal)",
      "default": "admin"
    },
    {
      "id": "installVsix",
      "type": "pickString",
      "description": "¿Instalar la extensión en este VS Code al terminar? (luego, recargar la ventana)",
      "options": [
        { "label": "Sí: generar el .vsix e instalarlo", "value": "--install" },
        { "label": "No: solo generar el .vsix", "value": "--no-install" }
      ],
      "default": "--install"
    },
    {
      "id": "devRole",
      "type": "pickString",
      "description": "Rol del usuario de pruebas",
      "options": ["admin", "user"],
      "default": "admin"
    }
  ]
}
