{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurar servidor (config/config.dev.json)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": ["--dev", "--no-reload", "--config", "config/config.dev.json"],
      "cwd": "${workspaceFolder}",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Depurar tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
