[Unit]
Description=StorageWeb - copia de seguridad de la base de datos y la configuración
Documentation=https://github.com/
After=storageweb.service

[Service]
Type=oneshot
User=@APP_USER@
Group=@APP_GROUP@
Environment=STORAGEWEB_CONFIG=@CONF_DIR@/config.json
WorkingDirectory=@DATA_DIR@
# Conserva las 14 copias más recientes en @DATA_DIR@/backups
ExecStart=@STORAGEWEB_BIN@ backup --keep 14
UMask=0077
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DATA_DIR@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
