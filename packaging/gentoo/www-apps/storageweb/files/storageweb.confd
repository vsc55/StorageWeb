# /etc/conf.d/storageweb

# Fichero de configuración
#STORAGEWEB_CONFIG="/etc/storageweb/config.json"

# Usuario y grupo del servicio
#STORAGEWEB_USER="storageweb"
#STORAGEWEB_GROUP="storageweb"

# Log (stdout y stderr del servidor)
#STORAGEWEB_LOG="/var/log/storageweb/storageweb.log"

# Opciones adicionales para "storageweb serve" (p. ej. "--host 0.0.0.0 --port 8080")
#STORAGEWEB_OPTS=""
