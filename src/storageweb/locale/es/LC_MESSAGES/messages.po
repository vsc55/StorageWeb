#: storageweb/patterns.py
#, python-format
msgid "Exceptions with «!» are not supported: %(pattern)s"
msgstr "Las excepciones con «!» no se admiten: %(pattern)s"

#: storageweb/patterns.py
#, python-format
msgid "Invalid pattern: %(pattern)s"
msgstr "Patrón no válido: %(pattern)s"

#: storageweb/patterns.py
#, python-format
msgid "This pattern would hide everything: %(pattern)s"
msgstr "Este patrón lo ocultaría todo: %(pattern)s"

#: storageweb/patterns.py
#, python-format
msgid "Too many patterns (at most %(n)s)."
msgstr "Demasiados patrones (como mucho %(n)s)."

#: storageweb/cli/__init__.py
msgid "StorageWeb: server and administration"
msgstr "StorageWeb: servidor y administración"

#: storageweb/cli/__init__.py
msgid "PATH"
msgstr "RUTA"

#: storageweb/cli/__init__.py
msgid "Path to config.json (default $STORAGEWEB_CONFIG, then /etc/storageweb/config.json)"
msgstr "Ruta a config.json (por defecto $STORAGEWEB_CONFIG, luego /etc/storageweb/config.json)"

#: storageweb/cli/backup.py
msgid "Destination folder (default <data_dir>/backups)"
msgstr "Carpeta de destino (por defecto <data_dir>/backups)"

#: storageweb/cli/backup.py
msgid "Keep only the N most recent backups in the folder"
msgstr "Conserva solo las N copias más recientes de la carpeta"

#: storageweb/cli/backup.py
msgid "Do not send it outside the server even if maintenance.offsite_location is set"
msgstr "No enviarla fuera del servidor aunque maintenance.offsite_location esté configurado"

#: storageweb/cli/backup.py
msgid "Back up the database, config.json and secret_key"
msgstr "Copia de seguridad de la base de datos, config.json y secret_key"

#: storageweb/cli/backup.py
#, python-format
msgid "Error: %(error)s"
msgstr "Error: %(error)s"

#: storageweb/cli/backup.py
#, python-format
msgid "The backup was made, but it could not be sent outside the server: %(error)s"
msgstr "La copia se ha hecho, pero no se ha podido enviar fuera del servidor: %(error)s"

#: storageweb/cli/backup.py
msgid "Backup folder (default <data_dir>/backups)"
msgstr "Carpeta de copias (por defecto <data_dir>/backups)"

#: storageweb/cli/backup.py
msgid "List the backups in a folder"
msgstr "Lista las copias de seguridad de una carpeta"

#: storageweb/cli/backup.py
#, python-format
msgid "%(path)s  %(date)s  v%(version)s  schema %(schema)s"
msgstr "%(path)s  %(date)s  v%(version)s  esquema %(schema)s"

#: storageweb/cli/backup.py
#, python-format
msgid "%(path)s  (not valid: %(error)s)"
msgstr "%(path)s  (no válida: %(error)s)"

#: storageweb/cli/backup.py
msgid "storageweb-backup-*.tar.gz file"
msgstr "Fichero storageweb-backup-*.tar.gz"

#: storageweb/cli/backup.py
msgid "Replace the existing database (a copy .antes-de-restaurar-* is kept first)"
msgstr "Reemplaza la base de datos existente (antes guarda una copia .antes-de-restaurar-*)"

#: storageweb/cli/backup.py
msgid "Write the config.json from the backup to this path"
msgstr "Escribe el config.json de la copia en esta ruta"

#: storageweb/cli/backup.py
msgid "Restore a backup (with the service stopped)"
msgstr "Restaura una copia (con el servicio parado)"

#: storageweb/cli/backup.py
#, python-format
msgid "Restored the backup from %(date)s (StorageWeb %(version)s, schema %(old)s -> %(new)s)."
msgstr "Restaurada la copia del %(date)s (StorageWeb %(version)s, esquema %(old)s -> %(new)s)."

#: storageweb/cli/backup.py
#, python-format
msgid "config.json from the backup saved to %(path)s"
msgstr "config.json de la copia guardado en %(path)s"

#: storageweb/cli/common.py
#, python-format
msgid "Configuration error: %(error)s"
msgstr "Error de configuración: %(error)s"

#: storageweb/cli/common.py
msgid "Password: "
msgstr "Contraseña: "

#: storageweb/cli/common.py
msgid "Repeat the password: "
msgstr "Repite la contraseña: "

#: storageweb/cli/common.py
msgid "The passwords do not match."
msgstr "Las contraseñas no coinciden."

#: storageweb/cli/common.py storageweb/web/views/groups.py
#, python-format
msgid "The user %(name)s does not exist."
msgstr "El usuario %(name)s no existe."

#: storageweb/cli/config.py
msgid "Create the database or apply pending migrations"
msgstr "Crea la base de datos o aplica las migraciones pendientes"

#: storageweb/cli/config.py
#, python-format
msgid "Database ready: %(path)s"
msgstr "Base de datos lista: %(path)s"

#: storageweb/cli/config.py
msgid "Maximum number of entries"
msgstr "Número máximo de entradas"

#: storageweb/cli/config.py
msgid "Filter by user"
msgstr "Filtra por usuario"

#: storageweb/cli/config.py
msgid "Only from this level up"
msgstr "Solo desde este nivel hacia arriba"

#: storageweb/cli/config.py
msgid "Show the audit log"
msgstr "Muestra el registro de auditoría"

#: storageweb/cli/config.py
msgid "Validate the configuration and warn if there is no administrator"
msgstr "Valida la configuración y avisa si no hay ningún administrador"

#: storageweb/cli/config.py
msgid "Config"
msgstr "Config"

#: storageweb/cli/config.py storageweb/web/templates/admin/overview.html
#: storageweb/web/templates/admin/settings/backups.html
#: storageweb/web/templates/admin/settings/system.html
msgid "Database"
msgstr "Base de datos"

#: storageweb/cli/config.py
msgid "Homes"
msgstr "Homes"

#: storageweb/cli/config.py storageweb/web/templates/base.html storageweb/web/templates/profile.html
msgid "Language"
msgstr "Idioma"

#: storageweb/cli/config.py
msgid "Public URL"
msgstr "Dirección pública"

#: storageweb/cli/config.py
msgid "(host of each request)"
msgstr "(el host de cada petición)"

#: storageweb/cli/config.py
msgid "Proxy"
msgstr "Proxy"

#: storageweb/cli/config.py
#, python-format
msgid "yes, %(hops)s hop(s)"
msgstr "sí, %(hops)s salto(s)"

#: storageweb/cli/config.py storageweb/cli/users.py
msgid "no"
msgstr "no"

#: storageweb/cli/config.py storageweb/web/nav.py storageweb/web/templates/admin/overview.html
#: storageweb/web/templates/admin/settings/_auth_tabs.html
msgid "Sign-in"
msgstr "Inicio de sesión"

#: storageweb/cli/config.py storageweb/web/templates/_ui.html storageweb/web/templates/browse.html
#: storageweb/web/templates/recent.html storageweb/web/templates/search.html
#: storageweb/web/templates/share.html
msgid "Location"
msgstr "Ubicación"

#: storageweb/cli/config.py
msgid "remote"
msgstr "remota"

#: storageweb/cli/config.py storageweb/web/js_messages.py
msgid "OK"
msgstr "OK"

#: storageweb/cli/config.py
msgid "MISSING"
msgstr "NO EXISTE"

#: storageweb/cli/config.py storageweb/core/backends/smb.py
msgid "Share"
msgstr "Compartida"

#: storageweb/cli/config.py
msgid "WARNING: there is no administrator. Create one with: user-add <user> --role admin"
msgstr "AVISO: no hay ningún administrador. Crea uno con: user-add <usuario> --role admin"

#: storageweb/cli/config.py
msgid "Valid configuration."
msgstr "Configuración válida."

#: storageweb/cli/config.py
msgid "Discard the settings saved from the web and go back to the default values"
msgstr "Descartar los ajustes guardados desde la web y volver a los valores predeterminados"

#: storageweb/cli/config.py
#, python-format
msgid ""
"Web settings of the profile %(profile)s discarded: the default values apply again, except what "
"config.json and the environment set (the service notices on the next request)."
msgstr ""
"Ajustes web del perfil %(profile)s descartados: vuelven los valores predeterminados, salvo lo que"
" fijan config.json y el entorno (el servicio lo nota en la siguiente petición)."

#: storageweb/cli/secrets.py
msgid "The secret (if missing, it is asked without showing it)"
msgstr "El secreto (si falta, se pide sin mostrarlo)"

#: storageweb/cli/secrets.py
msgid "Encrypt a secret to put it in config.json or in an environment variable"
msgstr "Cifrar un secreto para ponerlo en config.json o en una variable de entorno"

#: storageweb/cli/secrets.py
msgid "Secret: "
msgstr "Secreto: "

#: storageweb/cli/secrets.py
msgid "Nothing to encrypt."
msgstr "No hay nada que cifrar."

#: storageweb/cli/secrets.py
msgid "Create a new key for the stored secrets and encrypt them again (service stopped)"
msgstr "Crear una clave nueva para los secretos guardados y volver a cifrarlos (con el servicio parado)"

#: storageweb/cli/secrets.py
#, python-format
msgid "%(count)s settings re-encrypted with a new key. Put it in %(env)s before starting the service:"
msgstr ""
"%(count)s juegos de ajustes vueltos a cifrar con una clave nueva. Ponla en %(env)s antes de "
"arrancar el servicio:"

#: storageweb/cli/secrets.py
#, python-format
msgid "New key saved in %(path)s; %(count)s settings re-encrypted. Start the service again."
msgstr ""
"Clave nueva guardada en %(path)s; %(count)s juegos de ajustes vueltos a cifrar. Vuelve a arrancar"
" el servicio."

#: storageweb/cli/secrets.py
msgid "Secrets encrypted in config.json with the old key must be encrypted again with encrypt-secret."
msgstr ""
"Los secretos de config.json cifrados con la clave antigua hay que volver a cifrarlos con encrypt-"
"secret."

#: storageweb/cli/security.py
msgid "List blocked and allowed IP addresses"
msgstr "Lista las direcciones IP bloqueadas y permitidas"

#: storageweb/cli/security.py
msgid "There are no blocked or allowed addresses."
msgstr "No hay direcciones bloqueadas ni permitidas."

#: storageweb/cli/security.py storageweb/web/templates/admin/settings/ips.html
msgid "indefinitely"
msgstr "indefinidamente"

#: storageweb/cli/security.py
msgid "blocked"
msgstr "bloqueada"

#: storageweb/cli/security.py
msgid "allowed"
msgstr "permitida"

#: storageweb/cli/security.py
msgid "IP address or network (CIDR)"
msgstr "Dirección IP o red (CIDR)"

#: storageweb/cli/security.py
msgid "Remove every block"
msgstr "Quitar todos los bloqueos"

#: storageweb/cli/security.py
msgid "Unblock an IP address or network (rescue if you blocked yourself)"
msgstr "Desbloquea una IP o red (rescate si te has bloqueado)"

#: storageweb/cli/security.py
#, python-format
msgid "%(num)s block(s) removed (the service notices within 30 seconds)."
msgstr "%(num)s bloqueo(s) quitado(s) (el servicio lo nota en menos de 30 segundos)."

#: storageweb/cli/security.py storageweb/web/templates/admin/settings/ips.html
msgid "Note"
msgstr "Nota"

#: storageweb/cli/security.py
msgid "Add an IP address or network to the allow list (never blocked)"
msgstr "Añade una IP o red a la lista blanca (nunca se bloquea)"

#: storageweb/cli/security.py storageweb/web/views/settings/ips.py
#, python-format
msgid "%(network)s added to the allow list."
msgstr "%(network)s añadida a la lista blanca."

#: storageweb/cli/security.py storageweb/cli/users.py
#: storageweb/web/templates/admin/_user_import_results.html storageweb/web/templates/login.html
msgid "User name"
msgstr "Usuario"

#: storageweb/cli/security.py
msgid "Close every session"
msgstr "Cerrar todas las sesiones"

#: storageweb/cli/security.py
msgid "Close the open sessions of a user (or of everybody)"
msgstr "Cierra las sesiones abiertas de un usuario (o de todos)"

#: storageweb/cli/security.py
#, python-format
msgid "%(num)s session(s) closed."
msgstr "%(num)s sesión(es) cerrada(s)."

#: storageweb/cli/security.py
msgid "Remove the two-step verification of a user (lost phone and recovery codes)"
msgstr "Quitar la verificación en dos pasos de un usuario (perdió el móvil y los códigos de recuperación)"

#: storageweb/cli/security.py
#, python-format
msgid "«%(name)s» does not have two-step verification."
msgstr "«%(name)s» no tiene la verificación en dos pasos."

#: storageweb/cli/security.py
#, python-format
msgid "Two-step verification removed from «%(name)s»."
msgstr "Verificación en dos pasos quitada a «%(name)s»."

#: storageweb/cli/security.py
msgid "List which accounts have two-step verification"
msgstr "Listar qué cuentas tienen la verificación en dos pasos"

#: storageweb/cli/security.py
msgid "app"
msgstr "app"

#: storageweb/cli/security.py storageweb/web/templates/admin/users/_macros.html
#, python-format
msgid "%(num)s passkey"
msgid_plural "%(num)s passkeys"
msgstr[0] "%(num)s passkey"
msgstr[1] "%(num)s passkeys"

#: storageweb/cli/security.py
#, python-format
msgid "on: %(how)s (%(num)s recovery codes left)"
msgstr "activada: %(how)s (quedan %(num)s códigos de recuperación)"

#: storageweb/cli/security.py
msgid "required, not set up"
msgstr "obligatoria, sin configurar"

#: storageweb/cli/security.py storageweb/settings/fields.py
msgid "off"
msgstr "desactivado"

#: storageweb/cli/security.py
msgid "Download it from security.password_list_urls (or --url) as the own list"
msgstr "Descargarla de security.password_list_urls (o de --url) como lista propia"

#: storageweb/cli/security.py
msgid "Use this text file (one password per line) as the own list"
msgstr "Usar este fichero de texto (una contraseña por línea) como lista propia"

#: storageweb/cli/security.py
msgid "Delete the own list: the built-in one is used again"
msgstr "Borrar la lista propia: vuelve a usarse la de serie"

#: storageweb/cli/security.py
msgid "Address to download from (instead of the setting); repeatable"
msgstr "Dirección de la que descargarla (en lugar del ajuste); se puede repetir"

#: storageweb/cli/security.py
msgid "Show, download or replace the list of common passwords"
msgstr "Ver, descargar o cambiar la lista de contraseñas comunes"

#: storageweb/cli/security.py storageweb/web/views/settings/passwords.py
#, python-format
msgid "Common passwords list updated: %(num)s passwords."
msgstr "Lista de contraseñas comunes actualizada: %(num)s contraseñas."

#: storageweb/cli/security.py storageweb/web/views/settings/passwords.py
msgid "The list that comes with StorageWeb is used again."
msgstr "Se vuelve a usar la lista que viene con StorageWeb."

#: storageweb/cli/security.py storageweb/web/templates/admin/settings/passwords.html
#, python-format
msgid "Own list of this server: %(num)s passwords, from %(source)s, updated %(when)s."
msgstr "Lista propia de este servidor: %(num)s contraseñas, de %(source)s, actualizada el %(when)s."

#: storageweb/cli/security.py storageweb/web/templates/admin/settings/passwords.html
#, python-format
msgid "The list that comes with StorageWeb: %(num)s passwords (SecLists)."
msgstr "La lista que viene con StorageWeb: %(num)s contraseñas (SecLists)."

#: storageweb/cli/server.py
msgid "Overrides server.host"
msgstr "Sobrescribe server.host"

#: storageweb/cli/server.py
msgid "Overrides server.port"
msgstr "Sobrescribe server.port"

#: storageweb/cli/server.py
msgid "Development: debugger and automatic reload"
msgstr "Desarrollo: depurador y recarga automática"

#: storageweb/cli/server.py
msgid "With --dev, without reload (for debugging)"
msgstr "Con --dev, sin recarga (para depurar)"

#: storageweb/cli/server.py
msgid "Start the web server"
msgstr "Arranca el servidor web"

#: storageweb/cli/service.py
msgid "install, remove, start, stop or status"
msgstr "install, remove, start, stop o status"

#: storageweb/cli/service.py
msgid "Name of the service (default StorageWeb)"
msgstr "Nombre del servicio (por defecto StorageWeb)"

#: storageweb/cli/service.py
msgid ""
"Account that runs it: «virtual» (default: NT SERVICE\\<name>, with access only to the folders it "
"needs) or LocalSystem (full access to the computer)"
msgstr ""
"Cuenta que lo ejecuta: «virtual» (por defecto: NT SERVICE\\<nombre>, con acceso solo a las "
"carpetas que necesita) o LocalSystem (acceso total al equipo)"

#: storageweb/cli/service.py
#, python-format
msgid "Log: %(path)s"
msgstr "Registro: %(path)s"

#: storageweb/cli/service.py
msgid ""
"The Python from the Microsoft Store cannot run services: install it from python.org (or with the "
"Python install manager) and create the venv again."
msgstr ""
"El Python de la Microsoft Store no puede ejecutar servicios: instálalo desde python.org (o con el"
" instalador de Python) y vuelve a crear el venv."

#: storageweb/cli/service.py
#, python-format
msgid "The service %(name)s already exists. Remove it first: storageweb service remove"
msgstr "El servicio %(name)s ya existe. Quítalo antes: storageweb service remove"

#: storageweb/cli/service.py
#, python-format
msgid "«%(command)s» failed: %(output)s"
msgstr "«%(command)s» ha fallado: %(output)s"

#: storageweb/cli/service.py
#, python-format
msgid "Service %(name)s installed: it starts with the computer and restarts if it stops."
msgstr "Servicio %(name)s instalado: arranca con el equipo y se reinicia si se para."

#: storageweb/cli/service.py
#, python-format
msgid "Could not give %(account)s access to %(path)s: %(output)s"
msgstr "No se pudo dar a %(account)s acceso a %(path)s: %(output)s"

#: storageweb/cli/service.py
#, python-format
msgid "  Read access: %(path)s"
msgstr "  Lectura: %(path)s"

#: storageweb/cli/service.py
#, python-format
msgid "  Write access: %(path)s"
msgstr "  Escritura: %(path)s"

#: storageweb/cli/service.py
#, python-format
msgid ""
"Folders added later outside these (a shared folder on another disk) need the same access: icacls "
"<folder> /grant \"%(account)s:(OI)(CI)M\""
msgstr ""
"Las carpetas que añadas después fuera de estas (una compartida en otro disco) necesitan el mismo "
"acceso: icacls <carpeta> /grant \"%(account)s:(OI)(CI)M\""

#: storageweb/cli/service.py
#, python-format
msgid ""
"Warning: server.host is %(host)s. Behind Caddy, listen only on 127.0.0.1 so nobody can skip the "
"proxy."
msgstr ""
"Aviso: server.host es %(host)s. Detrás de Caddy, escucha solo en 127.0.0.1 para que nadie pueda "
"saltarse el proxy."

#: storageweb/cli/service.py
msgid "Start it with: storageweb service start"
msgstr "Arráncalo con: storageweb service start"

#: storageweb/cli/service.py
#, python-format
msgid "The service %(name)s is not installed."
msgstr "El servicio %(name)s no está instalado."

#: storageweb/cli/service.py
#, python-format
msgid "Service %(name)s removed. The access given to its account stays on the folders."
msgstr "Servicio %(name)s quitado. El acceso que se dio a su cuenta sigue en las carpetas."

#: storageweb/cli/service.py
#, python-format
msgid "The service %(name)s is not installed: storageweb service install"
msgstr "El servicio %(name)s no está instalado: storageweb service install"

#: storageweb/cli/service.py
#, python-format
msgid "Service %(name)s running."
msgstr "Servicio %(name)s en marcha."

#: storageweb/cli/service.py
#, python-format
msgid "The service %(name)s did not start."
msgstr "El servicio %(name)s no ha arrancado."

#: storageweb/cli/service.py
#, python-format
msgid "Service %(name)s stopped."
msgstr "Servicio %(name)s parado."

#: storageweb/cli/service.py
#, python-format
msgid "The service %(name)s is still stopping."
msgstr "El servicio %(name)s aún se está parando."

#: storageweb/cli/service.py
#, python-format
msgid "Service %(name)s: %(state)s"
msgstr "Servicio %(name)s: %(state)s"

#: storageweb/cli/service.py
msgid "Windows service: install, remove, start, stop or status"
msgstr "Servicio de Windows: instalar, quitar, arrancar, parar o ver su estado"

#: storageweb/cli/service.py
msgid "Only on Windows. On Linux the packages install the systemd service (storageweb.service)."
msgstr "Solo en Windows. En Linux, los paquetes instalan el servicio de systemd (storageweb.service)."

#: storageweb/cli/service.py
msgid "Run it from a terminal opened as administrator."
msgstr "Ejecútalo desde un terminal abierto como administrador."

#: storageweb/cli/service.py
#, python-format
msgid "Configuration file not found: %(path)s (use --config)"
msgstr "No se encuentra el fichero de configuración: %(path)s (usa --config)"

#: storageweb/cli/service_host.py
msgid ""
"This program is started by the Windows service manager (storageweb service start). To run "
"StorageWeb in a console: storageweb serve."
msgstr ""
"Este programa lo arranca el Administrador de servicios de Windows (storageweb service start). "
"Para ejecutar StorageWeb en una consola: storageweb serve."

#: storageweb/cli/users.py
msgid "User name (for Entra ID, the UPN: juan@contoso.com)"
msgstr "Nombre de usuario (para Entra ID, el UPN: juan@contoso.com)"

#: storageweb/cli/users.py
msgid ""
"Sign-in method of the account (default: the first one that keeps the password here, local). The "
"others are registered beforehand and linked on the first sign-in."
msgstr ""
"Método de inicio de sesión de la cuenta (por defecto, el primero que guarda la contraseña aquí: "
"local). Con los demás, el usuario se da de alta antes y se vincula en su primer inicio de sesión."

#: storageweb/cli/users.py
msgid "Role of the user: admin, user or the key of a role (default: the one of new accounts)"
msgstr "Rol del usuario: admin, user o la clave de un rol (de serie, el de las cuentas nuevas)"

#: storageweb/cli/users.py
msgid "Password (avoid it: it stays in the shell history; better let it ask)"
msgstr "Contraseña (evítalo: queda en el historial; mejor que la pregunte)"

#: storageweb/cli/users.py
msgid "Read the password from standard input"
msgstr "Lee la contraseña de la entrada estándar"

#: storageweb/cli/users.py storageweb/web/templates/admin/groups/_macros.html
#: storageweb/web/templates/admin/user_form.html storageweb/web/templates/admin/users/_macros.html
#: storageweb/web/templates/profile.html
msgid "Display name"
msgstr "Nombre visible"

#: storageweb/cli/users.py
msgid "Email address"
msgstr "Correo electrónico"

#: storageweb/cli/users.py
msgid "Comma-separated groups (they give access to shared folders)"
msgstr "Grupos separados por comas (dan acceso a carpetas compartidas)"

#: storageweb/cli/users.py
msgid "Custom personal folder (default storage.home_template)"
msgstr "Carpeta personal propia (por defecto storage.home_template)"

#: storageweb/cli/users.py
msgid "Create a user (local by default)"
msgstr "Crea un usuario (local por defecto)"

#: storageweb/cli/users.py
#, python-format
msgid "User %(name)s (%(source)s, %(role)s) created."
msgstr "Usuario %(name)s (%(source)s, %(role)s) creado."

#: storageweb/cli/users.py
msgid "New password (asked if omitted)"
msgstr "Nueva contraseña (si se omite, se pregunta)"

#: storageweb/cli/users.py
msgid "Change the password of a local user"
msgstr "Cambia la contraseña de un usuario local"

#: storageweb/cli/users.py
#, python-format
msgid "%(name)s is a %(source)s user; its password is not managed here."
msgstr "%(name)s es un usuario %(source)s; su contraseña no se gestiona aquí."

#: storageweb/cli/users.py
msgid "Password updated."
msgstr "Contraseña actualizada."

#: storageweb/cli/users.py
msgid "New role: admin, user or the key of a role"
msgstr "Rol nuevo: admin, user o la clave de un rol"

#: storageweb/cli/users.py
msgid "Comma-separated groups (replace the current ones)"
msgstr "Grupos separados por comas (sustituye los actuales)"

#: storageweb/cli/users.py
msgid "Personal folder; '' to go back to storage.home_template"
msgstr "Carpeta personal; '' para volver a storage.home_template"

#: storageweb/cli/users.py
msgid "Preferred interface language"
msgstr "Idioma preferido de la interfaz"

