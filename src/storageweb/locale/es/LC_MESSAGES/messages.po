msgstr "Quitar la ubicación"

#: storageweb/web/templates/admin/locations/edit.html
msgid "Only possible when no folder uses it. The files are not deleted."
msgstr "Solo si no la usa ninguna carpeta. Los archivos no se borran."

#: storageweb/web/templates/admin/locations/edit.html
