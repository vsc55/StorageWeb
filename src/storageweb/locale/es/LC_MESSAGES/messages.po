msgid "Restore a backup (with the service stopped)"
msgstr "Restaura una copia (con el servicio parado)"

#: storageweb/cli/backup.py
#, python-format
msgid "Restored the backup from %(date)s (StorageWeb %(version)s, schema %(old)s -> %(new)s)."
msgstr "Restaurada la copia del %(date)s (StorageWeb %(version)s, esquema %(old)s -> %(new)s)."

#: storageweb/cli/backup.py
#, python-format
msgid "config.json from the backup saved to %(path)s"
msgstr "config.json de la copia guardado en %(path)s"

