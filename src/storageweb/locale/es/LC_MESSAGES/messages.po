#, python-format
msgid "You cannot block the address you are using (%(ip)s)."
msgstr "No puedes bloquear la dirección que estás usando (%(ip)s)."

#: storageweb/core/network.py
msgid ""
"The request carries X-Forwarded-* headers but server.behind_proxy is disabled: they are ignored, "
"so the client address and the scheme are those of the proxy."
msgstr ""
"La petición trae cabeceras X-Forwarded-* pero server.behind_proxy está desactivado: se ignoran, "
"así que la dirección del cliente y el esquema son los del proxy."

#: storageweb/core/network.py
msgid ""
