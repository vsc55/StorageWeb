msgstr "Se usa cuando el usuario no ha elegido uno y el navegador no pide ninguno disponible."

#: storageweb/web/templates/admin/settings/general.html
msgid "Brand"
msgstr "Marca"

#: storageweb/web/templates/admin/settings/general.html
msgid "Main color"
msgstr "Color principal"

#: storageweb/web/templates/admin/settings/general.html
msgid "Buttons, links and highlights. It is used in the light and the dark theme."
msgstr "Botones, enlaces y resaltados. Se usa en el tema claro y en el oscuro."

#: storageweb/web/templates/admin/settings/general.html
msgid "Upload"
msgstr "Subir"

#: storageweb/web/templates/admin/settings/general.html
msgid "Remove logo"
msgstr "Quitar logo"

