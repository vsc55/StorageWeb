msgstr "Quitar ubicación"

#: storageweb/web/templates/admin/locations/index.html
#, python-format
msgid ""
"External storage (%(types)s) where shared or personal folders can live, without mounting it on "
"the server."
msgstr ""
"Almacenamiento externo (%(types)s) donde pueden estar las carpetas compartidas o personales, sin "
"montarlo en el servidor."

#: storageweb/web/templates/admin/locations/index.html
msgid "New location"
msgstr "Nueva ubicación"

#: storageweb/web/templates/admin/locations/index.html
msgid "Type of storage"
msgstr "Tipo de almacenamiento"

#: storageweb/web/templates/admin/locations/index.html
msgid "There are no storage locations: every folder is on the disk of the server."
msgstr "No hay ubicaciones de almacenamiento: todas las carpetas están en el disco del servidor."

#: storageweb/web/templates/admin/locations/index.html
msgid "NFS, SMB or rclone mounts need no location: mount them on the server and use their path."
msgstr "Los montajes NFS, SMB o rclone no necesitan ubicación: móntalos en el servidor y usa su ruta."

#: storageweb/web/templates/admin/locations/index.html
msgid ""
"Choose the location of each folder in Access → Shared folders, and of the personal folders in "
"Access → Personal folders."
msgstr ""
"La ubicación de cada carpeta se elige en Acceso → Carpetas compartidas, y la de las personales en"
" Acceso → Carpetas personales."

#: storageweb/web/templates/admin/settings/_macros.html
