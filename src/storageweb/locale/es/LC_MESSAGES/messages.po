msgstr "%(path)s  %(date)s  v%(version)s  esquema %(schema)s"

#: storageweb/cli/backup.py
#, python-format
msgid "%(path)s  (not valid: %(error)s)"
msgstr "%(path)s  (no válida: %(error)s)"

