msgstr "Modifica rol, grupos, carpeta, idioma o estado de un usuario"

#: storageweb/cli/users.py
msgid "Nothing to change."
msgstr "Nada que cambiar."

#: storageweb/cli/users.py
#, python-format
msgid "User %(name)s updated: %(fields)s"
msgstr "Usuario %(name)s actualizado: %(fields)s"

#: storageweb/cli/users.py
