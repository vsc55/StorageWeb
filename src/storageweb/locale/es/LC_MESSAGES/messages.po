#: storageweb/web/views/access.py
#, python-format
msgid "Shared folder «%(label)s» removed. Its files are still on the server."
msgstr "Carpeta compartida «%(label)s» quitada. Sus archivos siguen en el servidor."

#: storageweb/web/views/auth.py
msgid "Enter your user name and password."
msgstr "Introduce usuario y contraseña."

#: storageweb/web/views/auth.py
msgid "Too many failed attempts. Wait a few minutes."
msgstr "Demasiados intentos fallidos. Espera unos minutos."

#: storageweb/web/views/auth.py
msgid "Wrong user name or password."
msgstr "Usuario o contraseña incorrectos."

#: storageweb/web/views/auth.py
msgid "You have signed out."
msgstr "Sesión cerrada."

#: storageweb/web/views/auth.py
msgid "Could not contact the identity provider."
msgstr "No se pudo contactar con el proveedor de identidad."

#: storageweb/web/views/auth.py
msgid "The sign-in session expired. Try again."
msgstr "La sesión de inicio expiró. Inténtalo de nuevo."

#: storageweb/web/views/auth.py
msgid "Could not sign in with Microsoft."
msgstr "No se pudo iniciar sesión con Microsoft."

#: storageweb/web/views/files.py
msgid "This folder is read-only."
msgstr "Esta carpeta es de solo lectura."

#: storageweb/web/views/files.py
#, python-format
msgid "You are not allowed to: %(action)s."
msgstr "No tienes permiso para: %(action)s."

#: storageweb/web/views/files.py
msgid "The service is not allowed to read this folder."
msgstr "El servicio no tiene permisos para leer esta carpeta."

#: storageweb/web/views/files.py
msgid "write error"
msgstr "error de escritura"

#: storageweb/web/views/files.py
#, python-format
msgid "%(num)d file uploaded."
msgid_plural "%(num)d files uploaded."
msgstr[0] "Subido %(num)d archivo."
msgstr[1] "Subidos %(num)d archivos."

#: storageweb/web/views/files.py
#, python-format
msgid "Folder «%(name)s» created."
msgstr "Carpeta «%(name)s» creada."

#: storageweb/web/views/files.py
msgid "An item with that name already exists."
msgstr "Ya existe un elemento con ese nombre."

#: storageweb/web/views/files.py
#, python-format
msgid "Could not create the folder: %(error)s"
msgstr "No se pudo crear la carpeta: %(error)s"

#: storageweb/web/views/files.py
msgid "Renamed."
msgstr "Renombrado correctamente."

#: storageweb/web/views/files.py
#, python-format
msgid "Could not rename: %(error)s"
msgstr "No se pudo renombrar: %(error)s"

#: storageweb/web/views/files.py
#, python-format
msgid "«%(name)s» deleted."
msgstr "«%(name)s» eliminado."

#: storageweb/web/views/files.py
#, python-format
msgid "Could not delete: %(error)s"
msgstr "No se pudo eliminar: %(error)s"

#: storageweb/web/views/groups.py
#, python-format
msgid "Group «%(name)s» created."
msgstr "Grupo «%(name)s» creado."

#: storageweb/web/views/admin/users.py storageweb/web/views/groups.py
msgid "Changes saved."
msgstr "Cambios guardados."

#: storageweb/web/views/groups.py
#, python-format
msgid "Group «%(name)s» deleted. Users and files have not been touched."
msgstr "Grupo «%(name)s» eliminado. Los usuarios y los archivos no se han tocado."

#: storageweb/web/views/admin/users.py storageweb/web/views/groups.py
#, python-format
msgid "«%(user)s» added to the group «%(group)s»."
msgstr "«%(user)s» añadido al grupo «%(group)s»."

#: storageweb/web/views/groups.py
#, python-format
msgid "«%(user)s» removed from the group «%(group)s»."
msgstr "«%(user)s» quitado del grupo «%(group)s»."

#: storageweb/web/views/groups.py
#, python-format
msgid "Access saved: %(count)s changes."
msgstr "Accesos guardados: %(count)s cambios."

#: storageweb/web/views/groups.py
msgid "There were no changes."
msgstr "No había cambios."

#: storageweb/web/views/profile.py
msgid "Light"
msgstr "Claro"

#: storageweb/web/views/profile.py
msgid "Dark"
msgstr "Oscuro"

#: storageweb/web/views/profile.py
msgid "Profile saved."
msgstr "Perfil guardado."

#: storageweb/web/views/profile.py
msgid "The current password is not correct."
msgstr "La contraseña actual no es correcta."

#: storageweb/web/views/profile.py
msgid "The new passwords do not match."
msgstr "Las contraseñas nuevas no coinciden."

#: storageweb/web/views/profile.py
msgid "The new password must be different from the current one."
msgstr "La nueva contraseña debe ser distinta de la actual."

#: storageweb/web/views/profile.py
msgid "Password changed. Your other sessions have been closed."
msgstr "Contraseña cambiada. Se han cerrado tus otras sesiones."

#: storageweb/web/views/profile.py storageweb/web/views/settings/sessions.py
msgid "Session closed."
msgstr "Sesión cerrada."

#: storageweb/web/views/profile.py storageweb/web/views/settings/sessions.py
#, python-format
msgid "%(num)s session closed."
msgid_plural "%(num)s sessions closed."
msgstr[0] "%(num)s sesión cerrada."
msgstr[1] "%(num)s sesiones cerradas."

#: storageweb/web/views/profile.py storageweb/web/views/settings/sessions.py
#, python-format
msgid "Token «%(name)s» revoked."
msgstr "Token «%(name)s» revocado."

#: storageweb/web/views/admin/users.py
msgid "Select some users and an action."
msgstr "Selecciona algunos usuarios y una acción."

#: storageweb/web/views/admin/users.py
msgid "Choose the group."
msgstr "Elige el grupo."

#: storageweb/web/views/admin/users.py
#, python-format
msgid "Done for %(num)s user."
msgid_plural "Done for %(num)s users."
msgstr[0] "Hecho para %(num)s usuario."
msgstr[1] "Hecho para %(num)s usuarios."

#: storageweb/web/views/admin/users.py
#, python-format
msgid "User «%(name)s» enabled."
msgstr "Usuario «%(name)s» activado."

#: storageweb/web/views/admin/users.py
#, python-format
msgid "User «%(name)s» disabled: they can no longer sign in."
msgstr "Usuario «%(name)s» desactivado: ya no puede iniciar sesión."

#: storageweb/web/views/admin/users.py
#, python-format
msgid "User «%(name)s» created."
msgstr "Usuario «%(name)s» creado."

#: storageweb/web/views/admin/users.py
#, python-format
msgid "User «%(name)s» deleted (their files have not been removed)."
msgstr "Usuario «%(name)s» eliminado (sus archivos no se han borrado)."

#: storageweb/web/views/settings/backups.py
#, python-format
msgid "Database compacted: %(before)s → %(after)s."
msgstr "Base de datos compactada: %(before)s → %(after)s."

#: storageweb/web/views/settings/backups.py
msgid "Set the audit retention first."
msgstr "Define antes la retención de la auditoría."

#: storageweb/web/views/settings/backups.py
#, python-format
msgid "%(num)s audit entry removed."
msgid_plural "%(num)s audit entries removed."
msgstr[0] "%(num)s entrada de auditoría borrada."
msgstr[1] "%(num)s entradas de auditoría borradas."

#: storageweb/web/views/settings/backups.py
#, python-format
msgid "The backup failed: %(error)s"
msgstr "La copia ha fallado: %(error)s"

#: storageweb/web/views/settings/backups.py
#, python-format
msgid "Backup %(name)s created."
msgstr "Copia %(name)s creada."

#: storageweb/web/views/settings/backups.py
#, python-format
msgid "Backup %(name)s deleted."
msgstr "Copia %(name)s borrada."

#: storageweb/web/views/settings/branding.py
msgid "Choose an image."
msgstr "Elige una imagen."

#: storageweb/web/views/settings/branding.py
msgid "Logo updated."
msgstr "Logo actualizado."

#: storageweb/web/views/settings/branding.py
msgid "Logo removed."
msgstr "Logo quitado."

#: storageweb/web/views/settings/entra.py
msgid "Connection with Entra ID checked: everything is correct."
msgstr "Conexión con Entra ID comprobada: todo correcto."

#: storageweb/web/views/settings/entra.py
msgid "Connection with Entra ID checked: there are problems, see the details."
msgstr "Conexión con Entra ID comprobada: hay problemas, mira el detalle."

#: storageweb/web/views/settings/entra.py
msgid "Entra ID enabled. Users can now sign in with Microsoft."
msgstr "Entra ID activado. Los usuarios ya pueden iniciar sesión con Microsoft."

#: storageweb/web/views/settings/entra.py
msgid "Entra ID only accepts HTTPS return addresses: set the public name in Network and HTTPS."
msgstr "Entra ID solo acepta direcciones de vuelta HTTPS: define el nombre público en Red y HTTPS."

#: storageweb/web/views/settings/entra.py
#, python-format
msgid "Could not start the sign-in with Microsoft: %(error)s"
msgstr "No se pudo empezar el inicio de sesión con Microsoft: %(error)s"

#: storageweb/web/views/settings/entra.py
msgid "There is no Client ID configured."
msgstr "No hay ningún Client ID configurado."

#: storageweb/web/views/settings/entra.py
msgid "The sign-in code has expired or was cancelled. Start again."
msgstr "El código de inicio de sesión ha caducado o se ha cancelado. Empieza de nuevo."

#: storageweb/web/views/settings/entra.py
msgid "Microsoft has not confirmed the sign-in yet."
msgstr "Microsoft todavía no ha confirmado el inicio de sesión."

#: storageweb/web/views/settings/entra.py
#, python-format
msgid "Microsoft refused the sign-in: %(error)s"
msgstr "Microsoft ha rechazado el inicio de sesión: %(error)s"

#: storageweb/web/views/settings/entra.py
#, python-format
msgid "The secret could not be renewed: %(error)s"
msgstr "No se pudo renovar el secreto: %(error)s"

#: storageweb/web/views/settings/entra.py
msgid "New client secret created and saved. The previous one keeps working until it expires."
msgstr "Secreto de cliente nuevo creado y guardado. El anterior sigue funcionando hasta que caduque."

#: storageweb/web/views/settings/entra.py
#, python-format
msgid "Reading groups could not be granted: %(error)s"
msgstr "No se pudo conceder la lectura de grupos: %(error)s"

#: storageweb/web/views/settings/entra.py
msgid "The application can now read group names (it may take a minute)."
msgstr "La aplicación ya puede leer los nombres de los grupos (puede tardar un minuto)."

#: storageweb/web/views/settings/entra.py
#, python-format
msgid "The application could not be registered: %(error)s"
msgstr "No se pudo registrar la aplicación: %(error)s"

#: storageweb/web/views/settings/entra.py
#, python-format
msgid ""
"The application was created in Entra ID (%(client)s) but the settings could not be saved: "
"%(error)s"
msgstr "La aplicación se creó en Entra ID (%(client)s) pero no se pudieron guardar los ajustes: %(error)s"

#: storageweb/web/views/settings/entra.py
msgid "Application registered in Entra ID and saved."
msgstr "Aplicación registrada en Entra ID y guardada."

#: storageweb/web/views/settings/forms.py
msgid "Name of the application, default language, logo and color."
msgstr "Nombre de la aplicación, idioma por defecto, logo y color."

#: storageweb/web/views/settings/forms.py
msgid "Where personal folders live and upload limits."
msgstr "Dónde están las carpetas personales y límites de subida."

#: storageweb/web/views/settings/forms.py
msgid "What the «User» role can do. Administrators always have every permission."
msgstr "Qué puede hacer el rol «Usuario». Los administradores siempre tienen todos los permisos."

#: storageweb/web/views/settings/forms.py
msgid "How users sign in. Several methods can be enabled at the same time."
msgstr "Cómo inician sesión los usuarios. Puedes tener varios métodos activos a la vez."

#: storageweb/web/views/settings/forms.py
msgid "Protection against password guessing, automatic IP blocking and API tokens."
msgstr "Protección contra quien prueba contraseñas, bloqueo automático de IPs y tokens de API."

#: storageweb/web/views/settings/forms.py
msgid "Addresses blocked by hand or automatically, and addresses that are never blocked."
msgstr "Direcciones bloqueadas a mano o automáticamente, y direcciones que nunca se bloquean."

#: storageweb/web/views/settings/forms.py
msgid "How long the audit log is kept and how often backups are made."
msgstr "Cuánto se guarda la auditoría y cada cuánto se hacen copias."

#: storageweb/web/views/settings/forms.py
msgid "Backups, database size and cleanup tasks."
msgstr "Copias de seguridad, tamaño de la base de datos y tareas de limpieza."

#: storageweb/web/views/settings/forms.py
msgid ""
"Who is signed in now and which API tokens exist. Closing a session signs that browser out on its "
"next request."
msgstr ""
"Quién ha iniciado sesión ahora y qué tokens de API existen. Cerrar una sesión saca a ese "
"navegador en su siguiente petición."

#: storageweb/web/views/settings/forms.py
msgid ""
"Public address, reverse proxy and HTTPS. The proxy and the certificate are configured outside "
"StorageWeb; here you can check that everything matches."
msgstr ""
"Dirección pública, proxy inverso y HTTPS. El proxy y el certificado se configuran fuera de "
"StorageWeb; aquí compruebas que todo encaja."

#: storageweb/web/views/settings/forms.py
msgid "Startup settings and where each value comes from: default, web, config.json or environment."
msgstr "Ajustes de arranque y de dónde sale cada valor: predeterminado, web, config.json o entorno."

#: storageweb/web/views/settings/forms.py
#, python-format
msgid "%(field)s must be a number"
msgstr "%(field)s debe ser un número"

#: storageweb/web/views/settings/forms.py
#, python-format
msgid "Role mapping, line %(line)s: use the format «group = role»"
msgstr "Mapeo de roles, línea %(line)s: usa el formato «grupo = rol»"

#: storageweb/web/views/settings/forms.py
msgid "Maximum size per file"
msgstr "Tamaño máximo por archivo"

#: storageweb/web/views/settings/forms.py
msgid "Timeout"
msgstr "Tiempo de espera"

#: storageweb/web/views/settings/forms.py
msgid "Failed attempts"
msgstr "Intentos fallidos"

#: storageweb/web/views/settings/forms.py
msgid "Window"
msgstr "Ventana"

#: storageweb/web/views/settings/forms.py
msgid "Block duration"
msgstr "Duración del bloqueo"

#: storageweb/web/views/settings/forms.py
msgid "Audit retention"
msgstr "Retención de la auditoría"

#: storageweb/web/views/settings/forms.py
msgid "Automatic backups"
msgstr "Copias automáticas"

#: storageweb/web/views/settings/forms.py
msgid "Settings saved and applied."
msgstr "Ajustes guardados y aplicados."

#: storageweb/web/views/settings/forms.py
msgid "Web settings discarded: the default values apply again."
msgstr "Ajustes web descartados: vuelven los valores predeterminados."

#: storageweb/web/views/settings/forms.py
#, python-format
msgid "It cannot be reset: %(error)s"
msgstr "No se puede restablecer: %(error)s"

#: storageweb/web/views/settings/forms.py
#, python-format
msgid "«%(path)s» has its default value again."
msgstr "«%(path)s» vuelve a tener su valor predeterminado."

#: storageweb/web/views/settings/ips.py
#, python-format
msgid "%(network)s blocked."
msgstr "%(network)s bloqueada."

#: storageweb/web/views/settings/ips.py
#, python-format
