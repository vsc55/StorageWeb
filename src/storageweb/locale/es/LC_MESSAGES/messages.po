#: storageweb/web/views/settings/entra.py
#, python-format
msgid "The application could not be registered: %(error)s"
msgstr "No se pudo registrar la aplicación: %(error)s"

#: storageweb/web/views/settings/entra.py
#, python-format
msgid ""
"The application was created in Entra ID (%(client)s) but the settings could not be saved: "
"%(error)s"
msgstr "La aplicación se creó en Entra ID (%(client)s) pero no se pudieron guardar los ajustes: %(error)s"

#: storageweb/web/views/settings/entra.py
msgid "Application registered in Entra ID and saved."
msgstr "Aplicación registrada en Entra ID y guardada."

#: storageweb/web/views/settings/entra.py
msgid "Renew the Entra ID secret"
msgstr "Renovar el secreto de Entra ID"

#: storageweb/web/views/settings/entra.py
msgid "Register the application in Entra ID"
msgstr "Registrar la aplicación en Entra ID"

#: storageweb/web/views/settings/forms.py
msgid "Name of the application, default language, logo and color."
msgstr "Nombre de la aplicación, idioma por defecto, logo y color."

#: storageweb/web/views/settings/forms.py
msgid "Where personal folders live and how they are created."
msgstr "Dónde viven las carpetas personales y cómo se crean."

#: storageweb/web/views/settings/forms.py
msgid ""
"How much each personal folder can hold, whether what does not fit is blocked and how often the "
"usage is measured again."
msgstr ""
"Cuánto cabe en cada carpeta personal, si se bloquea lo que no cabe y cada cuánto se vuelve a "
"medir el uso."

#: storageweb/web/views/settings/forms.py
msgid ""
"Links to share a file or a folder with people without an account, and drop boxes to receive "
"files. Who can create them is the permission «Share with links» of the role."
msgstr ""
"Enlaces para compartir un archivo o una carpeta con gente sin cuenta, y buzones para recibir "
"archivos. Quién puede crearlos lo dice el permiso «Compartir con enlaces» del rol."

#: storageweb/web/views/settings/forms.py
msgid ""
"Which folders of the server disk can hold shared and personal folders, and the only ones that "
"Browse shows on it."
msgstr ""
"En qué carpetas del disco del servidor puede haber carpetas compartidas y personales, y las "
"únicas que Examinar enseña en él."

#: storageweb/web/views/settings/forms.py
msgid ""
"What the file browser shows, what does not exist for anyone, the largest file and how folders "
"with many items are shown."
msgstr ""
"Qué muestra el explorador, qué no existe para nadie, el archivo más grande y cómo se ven las "
"carpetas con muchos elementos."

#: storageweb/web/views/settings/forms.py
msgid ""
"How long the audit log is kept, from which level events are recorded and sending them to a SIEM "
"or syslog."
msgstr ""
"Cuánto se conserva la auditoría, desde qué nivel se guardan los eventos y su envío a un SIEM o "
"syslog."

#: storageweb/web/views/settings/forms.py
msgid "Backups made by the service itself and the copy outside the server."
msgstr "Las copias que hace el propio servicio y la copia fuera del servidor."

#: storageweb/web/views/settings/forms.py
msgid "Metrics for Prometheus: who can read them and how."
msgstr "Métricas para Prometheus: quién puede leerlas y cómo."

#: storageweb/web/views/settings/forms.py
msgid "How users sign in. Several methods can be enabled at the same time."
msgstr "Cómo inician sesión los usuarios. Puedes tener varios métodos activos a la vez."

#: storageweb/web/views/settings/forms.py
msgid "Protection against password guessing and automatic IP blocking."
msgstr "Protección contra quien prueba contraseñas y bloqueo automático de IPs."

#: storageweb/web/views/settings/forms.py
msgid ""
"What a new password of a local account must have and which ones are rejected: common ones, "
"forbidden words and passwords from known data breaches."
msgstr ""
"Qué tiene que tener una contraseña nueva de una cuenta local y cuáles se rechazan: las comunes, "
"las palabras prohibidas y las de filtraciones conocidas."

#: storageweb/web/views/settings/forms.py
msgid ""
"Security at a glance: key figures, a review of what is right and what to review (with where to "
"change it) and the latest security events."
msgstr ""
"La seguridad de un vistazo: cifras clave, un repaso de qué está bien y qué revisar (con dónde "
"cambiarlo) y los últimos sucesos de seguridad."

#: storageweb/web/views/settings/forms.py
msgid ""
"Known vulnerabilities and new versions of the installed libraries (Python and JavaScript), "
"checked with the button or automatically."
msgstr ""
"Vulnerabilidades conocidas y versiones nuevas de las bibliotecas instaladas (Python y "
"JavaScript), comprobadas con el botón o automáticamente."

#: storageweb/web/views/settings/forms.py
msgid "How scripts, apps and network drives reach the files: personal API tokens and WebDAV."
msgstr ""
"Cómo llegan a los archivos los scripts, las aplicaciones y las unidades de red: tokens de API "
"personales y WebDAV."

#: storageweb/web/views/settings/forms.py
msgid "Addresses blocked by hand or automatically, and addresses that are never blocked."
msgstr "Direcciones bloqueadas a mano o automáticamente, y direcciones que nunca se bloquean."

#: storageweb/web/views/settings/forms.py
msgid ""
"Which files open in the browser without downloading them, how large they can be and whether "
"Markdown diagrams are drawn."
msgstr ""
"Qué archivos se abren en el navegador sin descargarlos, de qué tamaño como mucho y si se dibujan "
"los diagramas del Markdown."

#: storageweb/web/views/settings/forms.py
msgid "Backups, database size and cleanup tasks."
msgstr "Copias de seguridad, tamaño de la base de datos y tareas de limpieza."

#: storageweb/web/views/settings/forms.py
msgid ""
"Who is signed in now and which API tokens exist. Closing a session signs that browser out on its "
"next request."
msgstr ""
"Quién ha iniciado sesión ahora y qué tokens de API existen. Cerrar una sesión saca a ese "
"navegador en su siguiente petición."

#: storageweb/web/views/settings/forms.py
msgid ""
"Public address, reverse proxy and HTTPS. The proxy and the certificate are configured outside "
"StorageWeb; here you can check that everything matches."
msgstr ""
"Dirección pública, proxy inverso y HTTPS. El proxy y el certificado se configuran fuera de "
"StorageWeb; aquí compruebas que todo encaja."

#: storageweb/web/views/settings/forms.py
msgid ""
"This installation (version, server, database, folders and components) with a report to download, "
"the startup settings and where each value comes from: default, web, config.json or environment."
msgstr ""
"Esta instalación (versión, servidor, base de datos, carpetas y componentes) con un informe para "
"descargar, los ajustes de arranque y de dónde sale cada valor: predeterminado, web, config.json o"
" entorno."

#: storageweb/web/views/settings/forms.py
msgid "Maximum size per file"
msgstr "Tamaño máximo por archivo"

#: storageweb/web/views/settings/forms.py
msgid "Failed attempts"
msgstr "Intentos fallidos"

#: storageweb/web/views/settings/forms.py
msgid "Window"
msgstr "Ventana"

#: storageweb/web/views/settings/forms.py
msgid "Block duration"
msgstr "Duración del bloqueo"

#: storageweb/web/views/settings/forms.py
msgid "Audit retention"
msgstr "Retención de la auditoría"

#: storageweb/web/views/settings/forms.py
msgid "Settings saved and applied."
msgstr "Ajustes guardados y aplicados."

#: storageweb/web/views/settings/forms.py
msgid "Web settings discarded: the default values apply again."
msgstr "Ajustes web descartados: vuelven los valores predeterminados."

#: storageweb/web/views/settings/forms.py
#, python-format
msgid "It cannot be reset: %(error)s"
msgstr "No se puede restablecer: %(error)s"

#: storageweb/web/views/settings/forms.py
#, python-format
msgid "«%(path)s» has its default value again."
msgstr "«%(path)s» vuelve a tener su valor predeterminado."

#: storageweb/web/views/settings/ips.py
#, python-format
msgid "%(network)s blocked."
msgstr "%(network)s bloqueada."

#: storageweb/web/views/settings/ips.py
#, python-format
msgid "%(network)s removed."
msgstr "%(network)s quitada."

#: storageweb/web/views/settings/passwords.py
msgid "Choose a text file with one password per line."
msgstr "Elige un fichero de texto con una contraseña por línea."

#: storageweb/web/views/settings/passwords.py
msgid "Press «Try» to check it."
msgstr "Pulsa «Probar» para comprobarla."

#: storageweb/web/views/settings/passwords.py
msgid "It would be accepted."
msgstr "Se aceptaría."

#: storageweb/web/views/settings/passwords.py
#, python-format
msgid "It would be rejected: %(num)s rule is not met."
msgid_plural "It would be rejected: %(num)s rules are not met."
msgstr[0] "Se rechazaría: no cumple %(num)s regla."
msgstr[1] "Se rechazaría: no cumple %(num)s reglas."

#: storageweb/web/views/settings/sessions.py
msgid "Select at least one session."
msgstr "Selecciona al menos una sesión."

#: storageweb/web/views/settings/sessions.py
msgid "Close all sessions"
msgstr "Cerrar todas las sesiones"

#: storageweb/web/views/settings/system.py
msgid "A check is already running."
msgstr "Ya hay una comprobación en marcha."

#: storageweb/web/views/settings/system.py
msgid "Checking the libraries in the background: the result will be here when it finishes."
msgstr "Comprobando las bibliotecas en segundo plano: el resultado estará aquí cuando acabe."

