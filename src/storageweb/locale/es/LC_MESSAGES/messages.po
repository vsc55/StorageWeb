#: storageweb/cli/__init__.py
msgid "StorageWeb: server and administration"
msgstr "StorageWeb: servidor y administración"

#: storageweb/cli/__init__.py
msgid "PATH"
msgstr "RUTA"

#: storageweb/cli/__init__.py
msgid "Path to config.json (default $STORAGEWEB_CONFIG, then /etc/storageweb/config.json)"
msgstr "Ruta a config.json (por defecto $STORAGEWEB_CONFIG, luego /etc/storageweb/config.json)"

#: storageweb/cli/__init__.py
msgid "Start the web server"
msgstr "Arranca el servidor web"

#: storageweb/cli/__init__.py
msgid "Overrides server.host"
msgstr "Sobrescribe server.host"

#: storageweb/cli/__init__.py
msgid "Overrides server.port"
msgstr "Sobrescribe server.port"

#: storageweb/cli/__init__.py
msgid "Development: debugger and automatic reload"
msgstr "Desarrollo: depurador y recarga automática"

#: storageweb/cli/__init__.py
msgid "With --dev, without reload (for debugging)"
msgstr "Con --dev, sin recarga (para depurar)"

#: storageweb/cli/__init__.py
msgid "Create the database or apply pending migrations"
msgstr "Crea la base de datos o aplica las migraciones pendientes"

#: storageweb/cli/__init__.py
msgid "Create a user (local by default)"
msgstr "Crea un usuario (local por defecto)"

#: storageweb/cli/__init__.py
msgid "User name (for Entra ID, the UPN: juan@contoso.com)"
msgstr "Nombre de usuario (para Entra ID, el UPN: juan@contoso.com)"

#: storageweb/cli/__init__.py
msgid "'entra' = register an Entra ID user beforehand (no password)"
msgstr "'entra' = alta previa de un usuario de Entra ID (sin contraseña)"

#: storageweb/cli/__init__.py
msgid "Role of the user"
msgstr "Rol del usuario"

#: storageweb/cli/__init__.py
msgid "Password (avoid it: it stays in the shell history; better let it ask)"
msgstr "Contraseña (evítalo: queda en el historial; mejor que la pregunte)"

#: storageweb/cli/__init__.py
msgid "Read the password from standard input"
msgstr "Lee la contraseña de la entrada estándar"

#: storageweb/cli/__init__.py storageweb/web/templates/admin/groups/_macros.html
#: storageweb/web/templates/admin/user_form.html storageweb/web/templates/admin/users/panel.html
#: storageweb/web/templates/profile.html
msgid "Display name"
msgstr "Nombre visible"

#: storageweb/cli/__init__.py
msgid "Email address"
msgstr "Correo electrónico"

#: storageweb/cli/__init__.py
msgid "Comma-separated groups (they give access to shared folders)"
msgstr "Grupos separados por comas (dan acceso a carpetas compartidas)"

#: storageweb/cli/__init__.py
msgid "Custom personal folder (default storage.home_template)"
msgstr "Carpeta personal propia (por defecto storage.home_template)"

#: storageweb/cli/__init__.py
msgid "Change the password of a local user"
msgstr "Cambia la contraseña de un usuario local"

#: storageweb/cli/__init__.py storageweb/web/templates/login.html
msgid "User name"
msgstr "Usuario"

#: storageweb/cli/__init__.py
msgid "New password (asked if omitted)"
msgstr "Nueva contraseña (si se omite, se pregunta)"

#: storageweb/cli/__init__.py
msgid "Change the role, groups, folder, language or status of a user"
msgstr "Modifica rol, grupos, carpeta, idioma o estado de un usuario"

#: storageweb/cli/__init__.py
msgid "New role"
msgstr "Nuevo rol"

#: storageweb/cli/__init__.py
msgid "Comma-separated groups (replace the current ones)"
msgstr "Grupos separados por comas (sustituye los actuales)"

#: storageweb/cli/__init__.py
msgid "Personal folder; '' to go back to storage.home_template"
msgstr "Carpeta personal; '' para volver a storage.home_template"

#: storageweb/cli/__init__.py
msgid "Preferred interface language"
msgstr "Idioma preferido de la interfaz"

#: storageweb/cli/__init__.py
msgid "Enable the account"
msgstr "Activa la cuenta"

#: storageweb/cli/__init__.py
msgid "Disable the account"
msgstr "Desactiva la cuenta"

#: storageweb/cli/__init__.py
msgid "Delete a user (their files are not removed)"
msgstr "Elimina un usuario (no borra sus archivos)"

#: storageweb/cli/__init__.py
msgid "List users"
msgstr "Lista usuarios"

#: storageweb/cli/__init__.py
msgid "Exit code 0 if the user exists, 1 if not"
msgstr "Código de salida 0 si el usuario existe, 1 si no"

#: storageweb/cli/__init__.py
msgid "Show the audit log"
msgstr "Muestra el registro de auditoría"

#: storageweb/cli/__init__.py
msgid "Maximum number of entries"
msgstr "Número máximo de entradas"

#: storageweb/cli/__init__.py
msgid "Filter by user"
msgstr "Filtra por usuario"

#: storageweb/cli/__init__.py
msgid "Validate the configuration and warn if there is no administrator"
msgstr "Valida la configuración y avisa si no hay ningún administrador"

#: storageweb/cli/__init__.py
msgid "Discard the settings saved from the web and go back to the default values"
msgstr "Descartar los ajustes guardados desde la web y volver a los valores predeterminados"

#: storageweb/cli/__init__.py
msgid "List blocked and allowed IP addresses"
msgstr "Lista las direcciones IP bloqueadas y permitidas"

#: storageweb/cli/__init__.py
msgid "Unblock an IP address or network (rescue if you blocked yourself)"
msgstr "Desbloquea una IP o red (rescate si te has bloqueado)"

#: storageweb/cli/__init__.py
msgid "IP address or network (CIDR)"
msgstr "Dirección IP o red (CIDR)"

#: storageweb/cli/__init__.py
msgid "Remove every block"
msgstr "Quitar todos los bloqueos"

#: storageweb/cli/__init__.py
msgid "Add an IP address or network to the allow list (never blocked)"
msgstr "Añade una IP o red a la lista blanca (nunca se bloquea)"

#: storageweb/cli/__init__.py storageweb/web/templates/admin/settings/ips.html
msgid "Note"
msgstr "Nota"

#: storageweb/cli/__init__.py
msgid "Close the open sessions of a user (or of everybody)"
msgstr "Cierra las sesiones abiertas de un usuario (o de todos)"

#: storageweb/cli/__init__.py
msgid "Close every session"
msgstr "Cerrar todas las sesiones"

#: storageweb/cli/__init__.py
msgid "Back up the database, config.json and secret_key"
msgstr "Copia de seguridad de la base de datos, config.json y secret_key"

#: storageweb/cli/__init__.py
msgid "Destination folder (default <data_dir>/backups)"
msgstr "Carpeta de destino (por defecto <data_dir>/backups)"

#: storageweb/cli/__init__.py
msgid "Keep only the N most recent backups in the folder"
msgstr "Conserva solo las N copias más recientes de la carpeta"

#: storageweb/cli/__init__.py
msgid "List the backups in a folder"
msgstr "Lista las copias de seguridad de una carpeta"

#: storageweb/cli/__init__.py
msgid "Backup folder (default <data_dir>/backups)"
msgstr "Carpeta de copias (por defecto <data_dir>/backups)"

#: storageweb/cli/__init__.py
msgid "Restore a backup (with the service stopped)"
msgstr "Restaura una copia (con el servicio parado)"

#: storageweb/cli/__init__.py
msgid "storageweb-backup-*.tar.gz file"
msgstr "Fichero storageweb-backup-*.tar.gz"

#: storageweb/cli/__init__.py
msgid "Replace the existing database (a copy .antes-de-restaurar-* is kept first)"
msgstr "Reemplaza la base de datos existente (antes guarda una copia .antes-de-restaurar-*)"

#: storageweb/cli/__init__.py
msgid "Write the config.json from the backup to this path"
msgstr "Escribe el config.json de la copia en esta ruta"

#: storageweb/cli/__init__.py storageweb/cli/server.py
#, python-format
msgid "Configuration error: %(error)s"
msgstr "Error de configuración: %(error)s"

#: storageweb/cli/backup.py
#, python-format
msgid "Error: %(error)s"
msgstr "Error: %(error)s"

#: storageweb/cli/backup.py
#, python-format
