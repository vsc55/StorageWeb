msgstr "Compartida"

#: storageweb/cli/config.py
msgid "WARNING: there is no administrator. Create one with: user-add <user> --role admin"
msgstr "AVISO: no hay ningún administrador. Crea uno con: user-add <usuario> --role admin"

#: storageweb/cli/config.py
msgid "Valid configuration."
msgstr "Configuración válida."

#: storageweb/cli/config.py
msgid "Discard the settings saved from the web and go back to the default values"
msgstr "Descartar los ajustes guardados desde la web y volver a los valores predeterminados"

#: storageweb/cli/config.py
#, python-format
msgid ""
"Web settings of the profile %(profile)s discarded: the default values apply again, except what "
"config.json and the environment set (the service notices on the next request)."
msgstr ""
"Ajustes web del perfil %(profile)s descartados: vuelven los valores predeterminados, salvo lo que"
" fijan config.json y el entorno (el servicio lo nota en la siguiente petición)."

#: storageweb/cli/secrets.py
msgid "The secret (if missing, it is asked without showing it)"
msgstr "El secreto (si falta, se pide sin mostrarlo)"

#: storageweb/cli/secrets.py
msgid "Encrypt a secret to put it in config.json or in an environment variable"
msgstr "Cifrar un secreto para ponerlo en config.json o en una variable de entorno"

#: storageweb/cli/secrets.py
msgid "Secret: "
msgstr "Secreto: "

#: storageweb/cli/secrets.py
msgid "Nothing to encrypt."
msgstr "No hay nada que cifrar."

#: storageweb/cli/secrets.py
msgid "Create a new key for the stored secrets and encrypt them again (service stopped)"
msgstr "Crear una clave nueva para los secretos guardados y volver a cifrarlos (con el servicio parado)"

#: storageweb/cli/secrets.py
#, python-format
msgid "%(count)s settings re-encrypted with a new key. Put it in %(env)s before starting the service:"
msgstr ""
"%(count)s juegos de ajustes vueltos a cifrar con una clave nueva. Ponla en %(env)s antes de "
"arrancar el servicio:"

#: storageweb/cli/secrets.py
#, python-format
msgid "New key saved in %(path)s; %(count)s settings re-encrypted. Start the service again."
msgstr ""
"Clave nueva guardada en %(path)s; %(count)s juegos de ajustes vueltos a cifrar. Vuelve a arrancar"
" el servicio."

#: storageweb/cli/secrets.py
msgid "Secrets encrypted in config.json with the old key must be encrypted again with encrypt-secret."
msgstr ""
"Los secretos de config.json cifrados con la clave antigua hay que volver a cifrarlos con encrypt-"
"secret."

#: storageweb/cli/security.py
msgid "List blocked and allowed IP addresses"
msgstr "Lista las direcciones IP bloqueadas y permitidas"

#: storageweb/cli/security.py
msgid "There are no blocked or allowed addresses."
msgstr "No hay direcciones bloqueadas ni permitidas."

#: storageweb/cli/security.py storageweb/web/templates/admin/settings/ips.html
msgid "indefinitely"
msgstr "indefinidamente"

#: storageweb/cli/security.py
msgid "blocked"
msgstr "bloqueada"

#: storageweb/cli/security.py
msgid "allowed"
msgstr "permitida"

#: storageweb/cli/security.py
msgid "IP address or network (CIDR)"
msgstr "Dirección IP o red (CIDR)"

#: storageweb/cli/security.py
msgid "Remove every block"
msgstr "Quitar todos los bloqueos"

#: storageweb/cli/security.py
msgid "Unblock an IP address or network (rescue if you blocked yourself)"
msgstr "Desbloquea una IP o red (rescate si te has bloqueado)"

#: storageweb/cli/security.py
#, python-format
msgid "%(num)s block(s) removed (the service notices within 30 seconds)."
msgstr "%(num)s bloqueo(s) quitado(s) (el servicio lo nota en menos de 30 segundos)."

#: storageweb/cli/security.py storageweb/web/templates/admin/settings/ips.html
msgid "Note"
msgstr "Nota"

#: storageweb/cli/security.py
msgid "Add an IP address or network to the allow list (never blocked)"
msgstr "Añade una IP o red a la lista blanca (nunca se bloquea)"

#: storageweb/cli/security.py storageweb/web/views/settings/ips.py
#, python-format
msgid "%(network)s added to the allow list."
msgstr "%(network)s añadida a la lista blanca."

#: storageweb/cli/security.py storageweb/cli/users.py storageweb/web/templates/login.html
msgid "User name"
msgstr "Usuario"

#: storageweb/cli/security.py
msgid "Close every session"
msgstr "Cerrar todas las sesiones"

#: storageweb/cli/security.py
msgid "Close the open sessions of a user (or of everybody)"
msgstr "Cierra las sesiones abiertas de un usuario (o de todos)"

#: storageweb/cli/security.py
#, python-format
msgid "%(num)s session(s) closed."
msgstr "%(num)s sesión(es) cerrada(s)."

#: storageweb/cli/security.py
msgid "Remove the two-step verification of a user (lost phone and recovery codes)"
msgstr "Quitar la verificación en dos pasos de un usuario (perdió el móvil y los códigos de recuperación)"

#: storageweb/cli/security.py
#, python-format
msgid "«%(name)s» does not have two-step verification."
msgstr "«%(name)s» no tiene la verificación en dos pasos."

#: storageweb/cli/security.py
#, python-format
msgid "Two-step verification removed from «%(name)s»."
msgstr "Verificación en dos pasos quitada a «%(name)s»."

#: storageweb/cli/security.py
msgid "List which accounts have two-step verification"
msgstr "Listar qué cuentas tienen la verificación en dos pasos"

#: storageweb/cli/security.py
#, python-format
msgid "on (%(num)s recovery codes left)"
msgstr "activada (quedan %(num)s códigos de recuperación)"

#: storageweb/cli/security.py
msgid "required, not set up"
msgstr "obligatoria, sin configurar"

#: storageweb/cli/security.py storageweb/settings/fields.py
msgid "off"
msgstr "desactivado"

#: storageweb/cli/server.py
msgid "Overrides server.host"
msgstr "Sobrescribe server.host"

#: storageweb/cli/server.py
msgid "Overrides server.port"
msgstr "Sobrescribe server.port"

#: storageweb/cli/server.py
msgid "Development: debugger and automatic reload"
msgstr "Desarrollo: depurador y recarga automática"

#: storageweb/cli/server.py
msgid "With --dev, without reload (for debugging)"
msgstr "Con --dev, sin recarga (para depurar)"

#: storageweb/cli/server.py
msgid "Start the web server"
msgstr "Arranca el servidor web"

#: storageweb/cli/service.py
msgid "install, remove, start, stop or status"
msgstr "install, remove, start, stop o status"

#: storageweb/cli/service.py
msgid "Name of the service (default StorageWeb)"
msgstr "Nombre del servicio (por defecto StorageWeb)"

#: storageweb/cli/service.py
msgid ""
"Account that runs it: «virtual» (default: NT SERVICE\\<name>, with access only to the folders it "
"needs) or LocalSystem (full access to the computer)"
msgstr ""
"Cuenta que lo ejecuta: «virtual» (por defecto: NT SERVICE\\<nombre>, con acceso solo a las "
"carpetas que necesita) o LocalSystem (acceso total al equipo)"

#: storageweb/cli/service.py
#, python-format
msgid "Log: %(path)s"
msgstr "Registro: %(path)s"

#: storageweb/cli/service.py
msgid ""
"The Python from the Microsoft Store cannot run services: install it from python.org (or with the "
"Python install manager) and create the venv again."
msgstr ""
"El Python de la Microsoft Store no puede ejecutar servicios: instálalo desde python.org (o con el"
" instalador de Python) y vuelve a crear el venv."

#: storageweb/cli/service.py
#, python-format
msgid "The service %(name)s already exists. Remove it first: storageweb service remove"
msgstr "El servicio %(name)s ya existe. Quítalo antes: storageweb service remove"

#: storageweb/cli/service.py
#, python-format
msgid "«%(command)s» failed: %(output)s"
msgstr "«%(command)s» ha fallado: %(output)s"

#: storageweb/cli/service.py
#, python-format
msgid "Service %(name)s installed: it starts with the computer and restarts if it stops."
msgstr "Servicio %(name)s instalado: arranca con el equipo y se reinicia si se para."

#: storageweb/cli/service.py
#, python-format
msgid "Could not give %(account)s access to %(path)s: %(output)s"
msgstr "No se pudo dar a %(account)s acceso a %(path)s: %(output)s"

#: storageweb/cli/service.py
#, python-format
msgid "  Read access: %(path)s"
msgstr "  Lectura: %(path)s"

#: storageweb/cli/service.py
#, python-format
msgid "  Write access: %(path)s"
msgstr "  Escritura: %(path)s"

#: storageweb/cli/service.py
#, python-format
msgid ""
"Folders added later outside these (a shared folder on another disk) need the same access: icacls "
"<folder> /grant \"%(account)s:(OI)(CI)M\""
msgstr ""
"Las carpetas que añadas después fuera de estas (una compartida en otro disco) necesitan el mismo "
"acceso: icacls <carpeta> /grant \"%(account)s:(OI)(CI)M\""

#: storageweb/cli/service.py
#, python-format
msgid ""
"Warning: server.host is %(host)s. Behind Caddy, listen only on 127.0.0.1 so nobody can skip the "
"proxy."
msgstr ""
"Aviso: server.host es %(host)s. Detrás de Caddy, escucha solo en 127.0.0.1 para que nadie pueda "
"saltarse el proxy."

#: storageweb/cli/service.py
msgid "Start it with: storageweb service start"
msgstr "Arráncalo con: storageweb service start"

#: storageweb/cli/service.py
#, python-format
msgid "The service %(name)s is not installed."
msgstr "El servicio %(name)s no está instalado."

#: storageweb/cli/service.py
#, python-format
msgid "Service %(name)s removed. The access given to its account stays on the folders."
msgstr "Servicio %(name)s quitado. El acceso que se dio a su cuenta sigue en las carpetas."

#: storageweb/cli/service.py
#, python-format
msgid "The service %(name)s is not installed: storageweb service install"
msgstr "El servicio %(name)s no está instalado: storageweb service install"

#: storageweb/cli/service.py
#, python-format
msgid "Service %(name)s running."
msgstr "Servicio %(name)s en marcha."

#: storageweb/cli/service.py
#, python-format
msgid "The service %(name)s did not start."
msgstr "El servicio %(name)s no ha arrancado."

#: storageweb/cli/service.py
#, python-format
msgid "Service %(name)s stopped."
msgstr "Servicio %(name)s parado."

#: storageweb/cli/service.py
#, python-format
msgid "The service %(name)s is still stopping."
msgstr "El servicio %(name)s aún se está parando."

#: storageweb/cli/service.py
#, python-format
msgid "Service %(name)s: %(state)s"
msgstr "Servicio %(name)s: %(state)s"

#: storageweb/cli/service.py
msgid "Windows service: install, remove, start, stop or status"
msgstr "Servicio de Windows: instalar, quitar, arrancar, parar o ver su estado"

#: storageweb/cli/service.py
msgid "Only on Windows. On Linux the packages install the systemd service (storageweb.service)."
msgstr "Solo en Windows. En Linux, los paquetes instalan el servicio de systemd (storageweb.service)."

#: storageweb/cli/service.py
msgid "Run it from a terminal opened as administrator."
msgstr "Ejecútalo desde un terminal abierto como administrador."

#: storageweb/cli/service.py
#, python-format
msgid "Configuration file not found: %(path)s (use --config)"
msgstr "No se encuentra el fichero de configuración: %(path)s (usa --config)"

#: storageweb/cli/service_host.py
msgid ""
"This program is started by the Windows service manager (storageweb service start). To run "
"StorageWeb in a console: storageweb serve."
msgstr ""
"Este programa lo arranca el Administrador de servicios de Windows (storageweb service start). "
"Para ejecutar StorageWeb en una consola: storageweb serve."

#: storageweb/cli/users.py
msgid "User name (for Entra ID, the UPN: juan@contoso.com)"
msgstr "Nombre de usuario (para Entra ID, el UPN: juan@contoso.com)"

