msgstr "El logo puede ocupar como mucho %(kb)s KB."

#: storageweb/core/branding.py
#, python-format
msgid "The file is not a valid %(type)s image."
msgstr "El fichero no es una imagen %(type)s válida."

#: storageweb/core/groups.py
msgid "Administrators"
msgstr "Administradores"

#: storageweb/core/groups.py
msgid "Users with the administrator role. Adding or removing members changes their role."
msgstr "Usuarios con rol de administrador. Añadir o quitar miembros cambia su rol."

#: storageweb/core/groups.py
msgid "The display name is required."
msgstr "El nombre visible es obligatorio."

#: storageweb/core/groups.py
#, python-format
